---
interface Props { name?: 'arrow' | 'diagonal' | 'instagram' | 'plus' | 'check' | 'copy' | 'menu' | 'whatsapp'; class?: string }
const { name = 'arrow', class: className } = Astro.props;
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M4 12h15M13 5l7 7-7 7" /></>}
  {name === 'diagonal' && <><path d="M6 18 18 6M6 6h12v12" /></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></>}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'copy' && <><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h3" /></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'whatsapp' && <><path d="M20 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.2-4.3A8.5 8.5 0 1 1 20 11.5Z" /><path d="M8 7.5c0 4 2.5 6.5 6.5 7l1.5-2-2.5-1-1 1a6 6 0 0 1-3-3l1-1L9 6Z" /></>}
</svg>
